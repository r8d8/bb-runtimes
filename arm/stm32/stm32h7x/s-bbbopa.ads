--  This package defines board parameters for the STM32H7 Discovery boards

package System.BB.Board_Parameters is
   pragma Pure;

   --------------------
   -- Clock Settings --
   --------------------

   --  STM32H743 Discovery uses 25 MHz external oscillator
   HSE_Clock_Frequency : constant := 25_000_000;

   --  Main system clock: 400 MHz (maximum for STM32H743)
   Main_Clock_Frequency : constant := 400_000_000;

   --  Internal 64 MHz oscillator
   HSI_Clock_Frequency : constant := 64_000_000;

   --  Low speed external oscillator (typically 32.768 kHz)
   LSE_Clock_Frequency : constant := 32_768;

end System.BB.Board_Parameters;
